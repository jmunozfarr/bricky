# PostgreSQL — convenient local defaults only. Replace the password before any
# environment is exposed beyond a trusted workstation.
POSTGRES_DB=bricky
POSTGRES_USER=bricky
POSTGRES_PASSWORD=bricky_dev_password
# Compose constructs DATABASE_URL inside the API container from these values;
# no host database URL or published PostgreSQL port is required.

# Linux bind-mount ownership. Set these to the numeric result of `id -u` and
# `id -g` so imported models, libraries, and backups remain host-manageable.
LOCAL_UID=1000
LOCAL_GID=1000

# Host project-local data directories mounted into containers.
LDRAW_DATA_PATH=./data/ldraw
MODEL_DATA_PATH=./data/models

# Container paths and explicit LDraw installation source.
LDRAW_LIBRARY_ROOT=/data/ldraw/official
LDRAW_LIBRARY_URL=https://library.ldraw.org/library/updates/complete.zip
MODEL_STORAGE_ROOT=/data/models

# Upload and on-demand instruction-graph resource limits. Keep the Nginx upload
# limit slightly above the API byte limit.
MODEL_MAX_UPLOAD_BYTES=26214400
INVENTORY_MAX_UPLOAD_BYTES=1048576
INSTRUCTION_GRAPH_MAX_NESTING_DEPTH=32
INSTRUCTION_GRAPH_MAX_EXPANDED_OCCURRENCES=10000
INSTRUCTION_GRAPH_MAX_INSTRUCTION_NODES=100000
RENDER_MAX_EXPANDED_INSTRUCTION_NODES=12000
RENDER_MAX_EXPANDED_OCCURRENCES=600
RENDER_MAX_DIRECT_GEOMETRY_COMMANDS=300000
RENDER_MAX_DERIVED_SOURCE_BYTES=33554432
NGINX_UPLOAD_LIMIT=26m

# Production-like local runtime. Only Nginx publishes a host port.
PROD_WEB_PORT=8080
API_WORKERS=2

# Rebrickable API key (free account: rebrickable.com -> Account Settings ->
# API). Used only by the planned Phase B mapping-table operator CLI to
# download BrickLink/LDraw ID mappings once — never at request time. Put the
# real key in .env only; see docs/BULK_INVENTORY.md.
REBRICKABLE_API_KEY=
